# Example environment configuration (safe to commit).
# Copy to `.env` in the repository root; the drivers and config builders load it with
# python-dotenv. Every variable is optional — leave it out to use the default.

# PROJECT_ROOT: repository root. Default: the current working directory
# (run scripts from the repository root).
# PROJECT_ROOT=/path/to/repository

# Output-folder label for spatial / temporal runs: checkpoints go to
# checkpoints/preles/<full|sparseN>/station_<label>/ (spatial) and the temporal equivalent.
# Set it to match the CV file you train on (e.g. len3 for CV_station_len3_config.json).
# The SLURM scripts derive it from the CV file name. Defaults: len12 (spatial), len1 (temporal).
spatial_training_years_len=len3
temporal_training_years_len=len1

# calibration_flag: what the training drivers do with PRELES calibrations.
#   auto             use an existing bundle, calibrate if it is missing (default)
#   require_existing fail if a bundle is missing (recommended with the shipped calibrations)
#   force_calibrate  recalibrate every split
#   defaults         use the default PRELES parameters
calibration_flag=require_existing

# N_TRIALS: Optuna trials per PRELES calibration (process_model_calibration_manager.py).
# Default 2000.
# N_TRIALS=2000

# Calibration root. Bundles live in Data/calibrations/ by default; only set this to use
# a different location. CALIBRATION_PATH overrides the root everywhere (absolute path,
# or relative to the data directory).
# CALIBRATION_PATH=/path/to/calibrations

# Weights & Biases: run `wandb login`, or switch logging off.
# WANDB_MODE=disabled

# ALE_GRID_SIZE: ALE grid resolution for XAI/scripts/run_ale.py (default 20).
# ALE_GRID_SIZE=20
